---
---

<div class="topbar">
  <div class="container">
    <div class="topbar__inner">

      <!-- LEFT: Social Icons + divider + Hours -->
      <div class="topbar__left">
        <div class="topbar__social" role="list" aria-label="Social media links">
          <a href="#" class="topbar__social-link" aria-label="Facebook" role="listitem">
            <svg viewBox="0 0 24 24" fill="currentColor" width="13" height="13" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
          <a href="#" class="topbar__social-link" aria-label="Twitter / X" role="listitem">
            <svg viewBox="0 0 24 24" fill="currentColor" width="13" height="13" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="#" class="topbar__social-link" aria-label="LinkedIn" role="listitem">
            <svg viewBox="0 0 24 24" fill="currentColor" width="13" height="13" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
          </a>
          <a href="#" class="topbar__social-link" aria-label="Instagram" role="listitem">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="13" height="13" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
        </div>

        <!-- Hours — hidden below 768px -->
        <span class="topbar__sep topbar__sep--hours" aria-hidden="true">|</span>
        <div class="topbar__hours">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="12" height="12" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>Mon - Fri : 08:00 - 21:30</span>
        </div>
      </div>

      <!-- RIGHT: Phone + Email — phone stays on tablet, email hides on mobile -->
      <div class="topbar__right">
        <a href="tel:+11234567890" class="topbar__contact">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="12" height="12" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.19h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.77a16 16 0 0 0 6.29 6.29l.95-.95a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <span>+1 (123) 456 7890</span>
        </a>

        <!-- Email — hidden below 768px -->
        <span class="topbar__sep topbar__sep--email" aria-hidden="true">|</span>
        <a href="mailto:info@example.com" class="topbar__contact topbar__contact--email">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="12" height="12" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          <span>info@example.com</span>
        </a>
      </div>

    </div>
  </div>
</div>

<style>
  /* ── Shell ── */
  .topbar {
    background:  var(--grey-800);
    color:       var(--grey-200);
    height:      var(--topbar-height);   /* 40px */
    font-family: var(--font-body);
    font-size:   var(--text-xs);
    font-weight: var(--fw-medium);
    position:    sticky;
    top:         0;
    z-index:     101;   /* sits above navbar (100) */
  }

  .topbar__inner {
    display:         flex;
    align-items:     center;
    justify-content: space-between;
    height:          100%;
  }

  /* ── Left ── */
  .topbar__left {
    display:     flex;
    align-items: center;
    gap:         var(--space-3);
    min-width:   0;
  }

  .topbar__social {
    display:     flex;
    align-items: center;
    gap:         var(--space-3);
    flex-shrink: 0;
  }

  .topbar__social-link {
    display:     flex;
    align-items: center;
    justify-content: center;
    color:       var(--grey-300);
    width:       20px;
    height:      20px;
    transition:  color var(--transition-fast);
  }
  .topbar__social-link:hover { color: var(--white); }

  .topbar__sep {
    color:       var(--grey-600);
    font-size:   var(--text-xs);
    flex-shrink: 0;
  }

  .topbar__hours {
    display:     flex;
    align-items: center;
    gap:         var(--space-2);
    color:       var(--grey-300);
    white-space: nowrap;
  }

  /* ── Right ── */
  .topbar__right {
    display:     flex;
    align-items: center;
    gap:         var(--space-3);
    flex-shrink: 0;
  }

  .topbar__contact {
    display:     flex;
    align-items: center;
    gap:         var(--space-2);
    color:       var(--grey-300);
    white-space: nowrap;
    text-decoration: none;
    transition:  color var(--transition-fast);
  }
  .topbar__contact:hover { color: var(--white); }

  /* ── Tablet: ≤ 900px — hide email, keep phone ── */
  @media (max-width: 900px) {
    .topbar__sep--email,
    .topbar__contact--email { display: none; }
  }

  /* ── Mobile: ≤ 640px — hide hours too, keep socials + phone ── */
  @media (max-width: 640px) {
    .topbar__sep--hours,
    .topbar__hours { display: none; }

    .topbar__social { gap: var(--space-2); }
    .topbar__right  { gap: var(--space-2); }
  }

  /* ── Very small: ≤ 400px — hide all text labels, keep icons ── */
  @media (max-width: 400px) {
    .topbar__contact span { display: none; }
    .topbar__social-link  { min-width: 16px; }
    .topbar__inner        { gap: var(--space-2); }
  }
</style>
