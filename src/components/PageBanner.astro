---
interface Props {
  title: string;
  breadcrumb?: { label: string; href?: string }[];
  bgImage?: string;
}

const { title, breadcrumb = [], bgImage } = Astro.props;
---

<section class="page-banner">
  {bgImage && <img src={bgImage} alt="" class="page-banner__bg" aria-hidden="true" />}
  <div class="page-banner__overlay"></div>
  <div class="container">
    <div class="page-banner__content">
      <h1 class="page-banner__title">{title}</h1>
      {breadcrumb.length > 0 && (
        <nav class="page-banner__breadcrumb" aria-label="Breadcrumb">
          <a href="/" class="crumb">Home</a>
          {breadcrumb.map((crumb, i) => (
            <>
              <span class="crumb-sep">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="12" height="12"><polyline points="9 18 15 12 9 6"/></svg>
              </span>
              {crumb.href && i < breadcrumb.length - 1
                ? <a href={crumb.href} class="crumb">{crumb.label}</a>
                : <span class="crumb crumb--active">{crumb.label}</span>
              }
            </>
          ))}
        </nav>
      )}
    </div>
  </div>
</section>

<style>
  .page-banner {
    position:   relative;
    background: var(--grey-800);
    min-height: 220px;
    display:    flex;
    align-items: center;
    overflow:   hidden;
  }

  .page-banner__bg {
    position:   absolute;
    inset:      0;
    width:      100%;
    height:     100%;
    object-fit: cover;
    z-index:    0;
  }

  /* Dark overlay */
  .page-banner__overlay {
    position:   absolute;
    inset:      0;
    background: rgba(10, 10, 10, 0.78);
    z-index:    1;
    pointer-events: none;
  }

  .page-banner__content {
    position:   relative;
    z-index:    2;
    padding-block: var(--space-12);
  }

  .page-banner__title {
    font-size:      var(--text-4xl);
    font-weight:    var(--fw-bold);
    color:          var(--white);
    letter-spacing: var(--ls-tight);
    margin-bottom:  var(--space-4);
  }

  /* Accent line under title */
  .page-banner__title::after {
    content:    '';
    display:    block;
    width:      50px;
    height:     3px;
    background: var(--grey-500);
    margin-top: var(--space-4);
  }

  /* Breadcrumb */
  .page-banner__breadcrumb {
    display:     flex;
    align-items: center;
    gap:         var(--space-2);
    flex-wrap:   wrap;
  }

  .crumb {
    font-size:   var(--text-sm);
    color:       var(--grey-300);
    text-decoration: none;
    transition:  color var(--transition-fast);
  }
  .crumb:hover {
    color: var(--white);
  }

  .crumb--active {
    color: var(--white);
    font-weight: var(--fw-medium);
  }

  .crumb-sep {
    color:       var(--grey-500);
    display:     flex;
    align-items: center;
  }

  @media (max-width: 768px) {
    .page-banner__title {
      font-size: var(--text-3xl);
    }
    .page-banner {
      min-height: 160px;
    }
  }
</style>
