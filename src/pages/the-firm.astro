---
import Layout from '../layouts/Layout.astro';
import PageBanner from '../components/PageBanner.astro';

const stats = [
  { number: '28+', label: 'Years of Experience' },
  { number: '1,200+', label: 'Cases Resolved' },
  { number: '98%', label: 'Client Satisfaction' },
];

const team = [
  { name: 'Krishna Kanth Pothireddy', role: 'MBA, LLB — Managing Partner', image: '/images/Krishna-Kanth-Pothireddy-img-1.webp' },
  { name: 'B. Sridhar Babu',         role: 'Senior Advocate',             image: '/images/B.-Sridhar-Babu-webp-848x1024.webp' },
  { name: 'Shanthi Raju',            role: 'Associate Partner',           image: '/images/Shanthi-Raju-img-webp-2.webp' },
  { name: 'Sreenivasa Murthy Inkollu', role: 'Corporate Counsel',         image: '/images/Sreenivasa-Murthy-Inkollu-img-webp.webp' },
];
---

<Layout title="The Firm" description="Learn about Satya Shastra — our history, values, and commitment to delivering exceptional legal services.">

  <PageBanner
    title="About Us"
    breadcrumb={[{ label: 'The Firm' }]}
    bgImage="/images/serious-lawyer-in-eyeglasses-working-with-papers-and-looking-at-camera-in-office-e1666440692618-768x633.jpg"
  />

  <!-- ── Section 1: About + Values ── -->
  <section class="section">
    <div class="container">
      <div class="firm__about-grid">

        <!-- Left: content -->
        <div class="firm__about-content">
          <span class="eyebrow">Who We Are</span>
          <h2 class="section-title">A Legacy of Legal Excellence</h2>
          <div class="divider"></div>
          <p>We give our clients legal advice that is focused on finding solutions and is creative. The firm serves entities from all industries, financial investors, governments, regulators, trade associations, and non-profit organizations.</p>

          <!-- 2×2 values grid -->
          <div class="firm__values">
            <div class="firm__value">
              <div class="firm__value-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              </div>
              <div>
                <h4>Achieve Excellence</h4>
                <p>We are committed to delivering the highest standard of legal service in every matter we handle, regardless of size or complexity.</p>
              </div>
            </div>
            <div class="firm__value">
              <div class="firm__value-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              </div>
              <div>
                <h4>Positivity is key</h4>
                <p>We approach every challenge with optimism and a solution-focused mindset, helping clients navigate difficulty with confidence.</p>
              </div>
            </div>
            <div class="firm__value">
              <div class="firm__value-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              </div>
              <div>
                <h4>Work Together</h4>
                <p>Collaboration is at the heart of everything we do — between our team, and in partnership with our clients to achieve shared goals.</p>
              </div>
            </div>
            <div class="firm__value">
              <div class="firm__value-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
              </div>
              <div>
                <h4>Take Courage!</h4>
                <p>We are never afraid to take on a difficult case or argue an unpopular position — we stand firmly by our clients when it matters most.</p>
              </div>
            </div>
          </div>

          <a href="/contact" class="btn btn--primary" style="margin-top: var(--space-8);">Book Appointment</a>
        </div>

        <!-- Right: image + phone badge -->
        <div class="firm__about-image-col">
          <div class="firm__about-image-wrap">
            <img src="/images/serious-lawyer-in-eyeglasses-working-with-papers-and-looking-at-camera-in-office-e1666440692618-768x633.jpg" alt="Satya Shastra legal offices" loading="lazy" />
            <div class="firm__phone-badge">
              <div class="firm__phone-badge-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.19h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.77a16 16 0 0 0 6.29 6.29l.95-.95a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </div>
              <div>
                <span class="firm__phone-badge-label">Call Us Today</span>
                <span class="firm__phone-badge-number">+1 (123) 456 7890</span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ── Section 2: Dark Feature Cards ── -->
  <section class="firm__dark-section">
    <div class="firm__dark-bg">
      <img src="/images/judge-gavel-justice-lawyers-business-woman-in-suit-or-lawyer-working-on-a-documents-legal-law-e1666440633507-768x739.jpg" alt="" role="presentation" loading="lazy" />
      <div class="firm__dark-overlay"></div>
    </div>
    <div class="container firm__dark-content">
      <div class="firm__dark-header">
        <span class="eyebrow eyebrow--light">Why Choose Us</span>
        <h2 class="section-title section-title--light">What Sets Us Apart</h2>
        <div class="divider divider--light"></div>
      </div>
      <div class="firm__feature-cards">
        <div class="firm__feature-card">
          <div class="firm__feature-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="28" height="28"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h3>Putting Clients First</h3>
          <p>Every decision we make is driven by your best interests. We listen, we understand, and we act — always with your goals at the centre of our strategy.</p>
        </div>
        <div class="firm__feature-card">
          <div class="firm__feature-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="28" height="28"><line x1="9" y1="18" x2="15" y2="18"/><line x1="10" y1="22" x2="14" y2="22"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
          </div>
          <h3>Providing Tailored Advice</h3>
          <p>No two legal matters are identical. We craft strategies that are specifically designed around your unique circumstances, objectives, and risk appetite.</p>
        </div>
        <div class="firm__feature-card">
          <div class="firm__feature-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="28" height="28"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
          </div>
          <h3>Crafting the Ideal Team</h3>
          <p>We assemble the right combination of expertise for every case — drawing from our diverse practice areas to provide seamless, comprehensive legal support.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Section 3: Trust Bar + Stats ── -->
  <section class="firm__trust-section">
    <div class="container">
      <div class="firm__trust-inner">
        <div class="firm__trust-text">
          <span class="eyebrow">Trusted by Clients Across India</span>
          <h2 class="section-title">Our Track Record Speaks for Itself</h2>
        </div>
        <div class="firm__stats">
          {stats.map(s => (
            <div class="firm__stat">
              <span class="firm__stat-number">{s.number}</span>
              <span class="firm__stat-label">{s.label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── Section 4: Our Team ── -->
  <section class="section section--gray">
    <div class="container">
      <div class="section-header text-center">
        <span class="eyebrow">The People Behind the Work</span>
        <h2 class="section-title">Meet Our Legal Team</h2>
        <div class="divider" style="margin: var(--space-4) auto var(--space-6);"></div>
      </div>

      <div class="firm__team-grid">
        {team.map(member => (
          <div class="firm__team-card">
            <div class="firm__team-image">
              <img src={member.image} alt={member.name} loading="lazy" />
            </div>
            <div class="firm__team-info">
              <h3 class="firm__team-name">{member.name}</h3>
              <p class="firm__team-role">{member.role}</p>
              <a href="/our-team" class="firm__team-link">
                View Profile
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="13" height="13"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
            </div>
          </div>
        ))}
      </div>

      <div class="text-center" style="margin-top: var(--space-10);">
        <a href="/our-team" class="btn btn--outline-dark">View All Team Members</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ── Section 1: About ── */
  .firm__about-grid {
    display:               grid;
    grid-template-columns: 55fr 45fr;
    gap:                   var(--space-16);
    align-items:           start;
  }

  .firm__about-content p {
    font-size:     var(--text-sm);
    line-height:   var(--lh-relaxed);
    color:         var(--grey-500);
    margin-bottom: var(--space-4);
  }

  .firm__values {
    display:               grid;
    grid-template-columns: 1fr 1fr;
    gap:                   var(--space-5);
    margin-top:            var(--space-8);
  }

  .firm__value {
    display:    flex;
    gap:        var(--space-4);
    align-items: flex-start;
    padding:    var(--space-4);
    border:     1px solid var(--grey-100);
  }

  .firm__value-icon {
    flex-shrink:     0;
    width:           44px;
    height:          44px;
    background:      var(--grey-800);
    color:           var(--white);
    display:         flex;
    align-items:     center;
    justify-content: center;
  }

  .firm__value h4 {
    font-size:     var(--text-sm);
    font-weight:   var(--fw-semibold);
    color:         var(--grey-800);
    margin-bottom: var(--space-1);
  }

  .firm__value p {
    font-size:   var(--text-xs);
    color:       var(--grey-500);
    line-height: var(--lh-relaxed);
  }

  .firm__about-image-wrap {
    position:     relative;
    aspect-ratio: 4 / 5;
    overflow:     hidden;
    background:   var(--grey-100);
  }

  .firm__about-image-wrap img {
    width:      100%;
    height:     100%;
    object-fit: cover;
  }

  .firm__phone-badge {
    position:    absolute;
    bottom:      var(--space-6);
    left:        calc(-1 * var(--space-8));
    background:  var(--grey-800);
    color:       var(--white);
    display:     flex;
    align-items: center;
    gap:         var(--space-4);
    padding:     var(--space-4) var(--space-5);
    min-width:   220px;
  }

  .firm__phone-badge-icon {
    flex-shrink:     0;
    width:           48px;
    height:          48px;
    border:          1px solid var(--grey-600);
    display:         flex;
    align-items:     center;
    justify-content: center;
  }

  .firm__phone-badge-label {
    display:     block;
    font-size:   var(--text-xs);
    color:       var(--grey-400);
    margin-bottom: 2px;
    text-transform: uppercase;
    letter-spacing: var(--ls-wide);
  }

  .firm__phone-badge-number {
    display:     block;
    font-size:   var(--text-base);
    font-weight: var(--fw-bold);
    color:       var(--white);
  }

  /* ── Section 2: Dark Feature Cards ── */
  .firm__dark-section {
    position: relative;
    padding:  var(--space-20) 0 calc(var(--space-20) + 80px);
    overflow: visible;
  }

  .firm__dark-bg {
    position:  absolute;
    inset:     0;
    z-index:   0;
    overflow:  hidden;
  }

  .firm__dark-bg img {
    width:      100%;
    height:     100%;
    object-fit: cover;
  }

  .firm__dark-overlay {
    position:   absolute;
    inset:      0;
    background: rgba(10, 10, 10, 0.82);
  }

  .firm__dark-content {
    position: relative;
    z-index:  1;
  }

  .firm__dark-header {
    text-align:    center;
    margin-bottom: var(--space-12);
  }

  .eyebrow--light {
    color: var(--grey-400);
  }

  .section-title--light {
    color: var(--white);
  }

  .divider--light {
    background:  var(--grey-500);
    margin:      var(--space-4) auto 0;
    width:       50px;
    height:      2px;
    border:      none;
    display:     block;
  }

  .firm__feature-cards {
    display:               grid;
    grid-template-columns: repeat(3, 1fr);
    gap:                   var(--space-6);
  }

  .firm__feature-card {
    background:    var(--white);
    padding:       var(--space-8) var(--space-7);
    border-top:    4px solid var(--grey-800);
    text-align:    center;
    transition:    transform var(--transition-normal), box-shadow var(--transition-normal);
  }

  .firm__feature-card:hover {
    transform:  translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .firm__feature-card-icon {
    width:           64px;
    height:          64px;
    background:      var(--grey-050);
    border:          1px solid var(--grey-100);
    display:         flex;
    align-items:     center;
    justify-content: center;
    margin:          0 auto var(--space-5);
    color:           var(--grey-800);
  }

  .firm__feature-card h3 {
    font-size:     var(--text-xl);
    font-weight:   var(--fw-bold);
    color:         var(--grey-800);
    margin-bottom: var(--space-4);
    font-family:   var(--font-heading);
  }

  .firm__feature-card p {
    font-size:   var(--text-sm);
    color:       var(--grey-500);
    line-height: var(--lh-relaxed);
  }

  /* ── Section 3: Trust + Stats ── */
  .firm__trust-section {
    background:  var(--grey-050);
    padding:     var(--space-16) 0;
    border-top:  1px solid var(--grey-100);
    margin-top:  calc(-1 * 80px); /* pull up to overlap dark section */
    padding-top: calc(80px + var(--space-16));
  }

  .firm__trust-inner {
    display:         flex;
    align-items:     center;
    justify-content: space-between;
    gap:             var(--space-12);
  }

  .firm__trust-text {
    flex:     1;
    max-width: 480px;
  }

  .firm__stats {
    display:    flex;
    gap:        var(--space-12);
    flex-shrink: 0;
  }

  .firm__stat {
    text-align: center;
  }

  .firm__stat-number {
    display:     block;
    font-family: var(--font-heading);
    font-size:   var(--text-5xl);
    font-weight: var(--fw-bold);
    color:       var(--grey-800);
    line-height: 1;
  }

  .firm__stat-label {
    display:     block;
    font-size:   var(--text-sm);
    color:       var(--grey-500);
    margin-top:  var(--space-2);
    white-space: nowrap;
  }

  /* ── Section 4: Team ── */
  .firm__team-grid {
    display:               grid;
    grid-template-columns: repeat(4, 1fr);
    gap:                   var(--space-6);
    margin-top:            var(--space-10);
  }

  .firm__team-card {
    background: var(--white);
    overflow:   hidden;
    transition: box-shadow var(--transition-normal);
  }
  .firm__team-card:hover {
    box-shadow: var(--shadow-md);
  }

  .firm__team-image {
    aspect-ratio: 3 / 4;
    overflow:     hidden;
    background:   var(--grey-100);
  }

  .firm__team-image img {
    width:      100%;
    height:     100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .firm__team-card:hover .firm__team-image img {
    transform: scale(1.04);
  }

  .firm__team-info {
    padding:    var(--space-5);
    border-top: 3px solid var(--grey-800);
  }

  .firm__team-name {
    font-size:     var(--text-base);
    font-weight:   var(--fw-bold);
    color:         var(--grey-800);
    margin-bottom: var(--space-1);
    line-height:   var(--lh-snug);
  }

  .firm__team-role {
    font-size:     var(--text-xs);
    color:         var(--grey-500);
    margin-bottom: var(--space-4);
  }

  .firm__team-link {
    display:         inline-flex;
    align-items:     center;
    gap:             var(--space-2);
    font-size:       var(--text-xs);
    font-weight:     var(--fw-semibold);
    color:           var(--grey-800);
    text-decoration: none;
    text-transform:  uppercase;
    letter-spacing:  var(--ls-wide);
    transition:      gap var(--transition-fast);
  }
  .firm__team-link:hover {
    gap: var(--space-3);
  }

  /* ── Responsive ── */
  @media (max-width: 1100px) {
    .firm__team-grid { grid-template-columns: repeat(2, 1fr); }
    .firm__feature-cards { grid-template-columns: 1fr; }
    .firm__stats { gap: var(--space-8); }
  }

  @media (max-width: 1024px) {
    .firm__about-grid {
      grid-template-columns: 1fr;
    }
    .firm__phone-badge {
      left: var(--space-4);
    }
    .firm__trust-inner {
      flex-direction: column;
      align-items:    flex-start;
    }
  }

  @media (max-width: 768px) {
    .firm__values       { grid-template-columns: 1fr; }
    .firm__stats        { gap: var(--space-6); }
    .firm__stat-number  { font-size: var(--text-4xl); }
  }

  @media (max-width: 600px) {
    .firm__team-grid { grid-template-columns: 1fr; }
    .firm__stats     { flex-wrap: wrap; justify-content: center; }
  }
</style>
