---
import Layout from '../../layouts/Layout.astro';
import PageBanner from '../../components/PageBanner.astro';
import { blogPosts } from '../../data/blogPosts.js';

export function getStaticPaths() {
  return blogPosts.map(post => ({
    params: { slug: post.slug },
    props:  { post },
  }));
}

const { post } = Astro.props;
const related = blogPosts.filter(p => p.slug !== post.slug).slice(0, 3);
---

<Layout title={post.title} description={post.excerpt}>

  <PageBanner
    title={post.title}
    breadcrumb={[
      { label: 'Blog', href: '/blog' },
      { label: post.category },
    ]}
    bgImage={post.image}
  />

  <section class="section">
    <div class="container">
      <div class="post__layout">

        <!-- ── Article ── -->
        <article class="post__article">
          <div class="post__meta">
            <span class="post__category">{post.category}</span>
            <span class="post__date">{post.date}</span>
          </div>

          <div class="post__hero">
            <img src={post.image} alt={post.title} />
          </div>

          <div class="post__content">
            {post.content.map((section: { heading: string; body: string }) => (
              <div class="post__section">
                <h2 class="post__section-heading">{section.heading}</h2>
                <p class="post__section-body">{section.body}</p>
              </div>
            ))}
          </div>
        </article>

        <!-- ── Sidebar ── -->
        <aside class="post__sidebar">

          <!-- CTA Card -->
          <div class="sidebar__cta">
            <div class="sidebar__cta-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="32" height="32"><line x1="12" y1="3" x2="12" y2="21"/><path d="M3 6l9-3 9 3"/><path d="M5 10l-2 7h4z"/><path d="M19 10l-2 7h4z"/><line x1="5" y1="21" x2="19" y2="21"/></svg>
            </div>
            <h3 class="sidebar__cta-title">Need Legal Advice?</h3>
            <p class="sidebar__cta-text">Our attorneys are available to discuss your matter in complete confidence.</p>
            <a href="/contact" class="btn btn--primary sidebar__cta-btn">Book a Consultation</a>
          </div>

          <!-- Related Posts -->
          {related.length > 0 && (
            <div class="sidebar__related">
              <h4 class="sidebar__related-heading">More Articles</h4>
              <ul class="sidebar__related-list">
                {related.map(r => (
                  <li class="sidebar__related-item">
                    <a href={`/blog/${r.slug}`} class="sidebar__related-link">
                      <img src={r.image} alt={r.title} class="sidebar__related-img" loading="lazy" />
                      <div class="sidebar__related-info">
                        <span class="sidebar__related-cat">{r.category}</span>
                        <span class="sidebar__related-title">{r.title}</span>
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

        </aside>

      </div>
    </div>
  </section>

</Layout>

<style>
  .post__layout {
    display:               grid;
    grid-template-columns: 1fr 340px;
    gap:                   var(--space-12);
    align-items:           start;
  }

  /* ── Meta ── */
  .post__meta {
    display:     flex;
    align-items: center;
    gap:         var(--space-4);
    margin-bottom: var(--space-6);
  }

  .post__category {
    background:     var(--grey-800);
    color:          var(--white);
    font-size:      var(--text-xs);
    font-weight:    var(--fw-semibold);
    padding:        4px 12px;
    text-transform: uppercase;
    letter-spacing: var(--ls-wide);
  }

  .post__date {
    font-size:      var(--text-xs);
    color:          var(--grey-400);
    text-transform: uppercase;
    letter-spacing: var(--ls-wide);
  }

  /* ── Hero Image ── */
  .post__hero {
    aspect-ratio: 16 / 7;
    overflow:     hidden;
    background:   var(--grey-100);
    margin-bottom: var(--space-10);
  }
  .post__hero img {
    width:      100%;
    height:     100%;
    object-fit: cover;
    display:    block;
  }

  /* ── Content ── */
  .post__content {
    display:        flex;
    flex-direction: column;
    gap:            var(--space-8);
  }

  .post__section-heading {
    font-size:     var(--text-xl);
    font-weight:   var(--fw-bold);
    color:         var(--grey-800);
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom:  2px solid var(--grey-100);
    line-height:   var(--lh-snug);
  }

  .post__section-body {
    font-size:   var(--text-sm);
    color:       var(--grey-500);
    line-height: var(--lh-relaxed);
  }

  /* ── Sidebar CTA ── */
  .sidebar__cta {
    background:    var(--grey-800);
    padding:       var(--space-8);
    color:         var(--white);
    text-align:    center;
    margin-bottom: var(--space-8);
  }

  .sidebar__cta-icon {
    display:         flex;
    justify-content: center;
    color:           var(--grey-400);
    margin-bottom:   var(--space-4);
  }

  .sidebar__cta-title {
    font-size:     var(--text-xl);
    font-weight:   var(--fw-bold);
    color:         var(--white);
    margin-bottom: var(--space-3);
  }

  .sidebar__cta-text {
    font-size:     var(--text-sm);
    color:         var(--grey-300);
    line-height:   var(--lh-relaxed);
    margin-bottom: var(--space-6);
  }

  .sidebar__cta-btn {
    width: 100%;
    justify-content: center;
  }

  /* ── Related Posts ── */
  .sidebar__related-heading {
    font-size:      var(--text-xs);
    font-weight:    var(--fw-semibold);
    color:          var(--grey-800);
    text-transform: uppercase;
    letter-spacing: var(--ls-wider);
    margin-bottom:  var(--space-5);
    padding-bottom: var(--space-3);
    border-bottom:  2px solid var(--grey-800);
  }

  .sidebar__related-list {
    list-style: none;
    display:    flex;
    flex-direction: column;
    gap:        var(--space-4);
  }

  .sidebar__related-link {
    display:         flex;
    gap:             var(--space-4);
    text-decoration: none;
    align-items:     flex-start;
    transition:      opacity var(--transition-fast);
  }
  .sidebar__related-link:hover { opacity: 0.75; }

  .sidebar__related-img {
    flex-shrink:  0;
    width:        72px;
    height:       52px;
    object-fit:   cover;
    background:   var(--grey-100);
    display:      block;
  }

  .sidebar__related-info {
    display:        flex;
    flex-direction: column;
    gap:            var(--space-1);
  }

  .sidebar__related-cat {
    font-size:      var(--text-xs);
    color:          var(--grey-400);
    text-transform: uppercase;
    letter-spacing: var(--ls-wide);
  }

  .sidebar__related-title {
    font-size:   var(--text-sm);
    font-weight: var(--fw-semibold);
    color:       var(--grey-800);
    line-height: var(--lh-snug);
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .post__layout {
      grid-template-columns: 1fr;
    }
    .post__sidebar {
      order: -1;
    }
    .sidebar__cta {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .post__hero { aspect-ratio: 16 / 9; }
  }
</style>
