---
import Layout from '../layouts/Layout.astro';
import PageBanner from '../components/PageBanner.astro';
---

<Layout title="Contact Us" description="Get in touch with Satya Shastra. Book a consultation or reach us by phone, email, or visit our office.">

  <PageBanner
    title="Contact Us"
    breadcrumb={[{ label: 'Contact Us' }]}
    bgImage="/images/serious-lawyer-in-eyeglasses-working-with-papers-and-looking-at-camera-in-office-e1666440692618-768x633.jpg"
  />

  <section class="section">
    <div class="container">
      <div class="contact__grid">

        <!-- Contact Form -->
        <div class="contact__form-col">
          <span class="eyebrow">Get in Touch</span>
          <h2 class="section-title">Book a Consultation</h2>
          <div class="divider"></div>
          <p style="font-size: var(--text-sm); color: var(--grey-500); margin-bottom: var(--space-8); line-height: var(--lh-relaxed);">
            Fill out the form below and one of our attorneys will get back to you within one business day. All enquiries are handled with strict confidentiality.
          </p>

          <div id="form-success" class="form__success" hidden>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="32" height="32" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            <h3>Message Sent</h3>
            <p>Thank you. One of our attorneys will be in touch within one business day.</p>
          </div>

          <form class="contact__form" id="contactForm" novalidate>
            <div id="form-error" class="form__error" hidden></div>
            <div class="form__row">
              <div class="form__group">
                <label class="form__label" for="name">Full Name *</label>
                <input class="form__input" type="text" id="name" name="name" placeholder="Your full name" required />
              </div>
              <div class="form__group">
                <label class="form__label" for="email">Email Address *</label>
                <input class="form__input" type="email" id="email" name="email" placeholder="your@email.com" required />
              </div>
            </div>
            <div class="form__row">
              <div class="form__group">
                <label class="form__label" for="phone">Phone Number</label>
                <input class="form__input" type="tel" id="phone" name="phone" placeholder="+91 00000 00000" />
              </div>
              <div class="form__group">
                <label class="form__label" for="subject">Subject *</label>
                <select class="form__input form__select" id="subject" name="subject" required>
                  <option value="" disabled selected>Select a practice area</option>
                  <option>Family Law</option>
                  <option>Intellectual Property</option>
                  <option>Consumer Rights</option>
                  <option>Insolvency &amp; Bankruptcy</option>
                  <option>Civil Litigation</option>
                  <option>Corporate Practice</option>
                  <option>Dispute Resolution</option>
                  <option>Employment / Labour &amp; Benefit</option>
                  <option>General Enquiry</option>
                </select>
              </div>
            </div>
            <div class="form__group">
              <label class="form__label" for="message">Message *</label>
              <textarea class="form__input form__textarea" id="message" name="message" placeholder="Briefly describe your legal matter..." required></textarea>
            </div>
            <button type="submit" class="btn btn--primary btn--lg" id="submitBtn">Send Message</button>
          </form>
        </div>

        <!-- Contact Info -->
        <div class="contact__info-col">
          <div class="contact__info-card">
            <h4>Contact Information</h4>

            <ul class="contact__info-list">
              <li class="contact__info-item">
                <span class="contact__info-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.19h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.77a16 16 0 0 0 6.29 6.29l.95-.95a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                </span>
                <div>
                  <span class="contact__info-label">Phone</span>
                  <a href="tel:+11234567890" class="contact__info-value">+1 (123) 456 7890</a>
                </div>
              </li>
              <li class="contact__info-item">
                <span class="contact__info-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                </span>
                <div>
                  <span class="contact__info-label">Email</span>
                  <a href="mailto:info@example.com" class="contact__info-value">info@example.com</a>
                </div>
              </li>
              <li class="contact__info-item">
                <span class="contact__info-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                </span>
                <div>
                  <span class="contact__info-label">Office Address</span>
                  <span class="contact__info-value">123, King Street, New York, USA</span>
                </div>
              </li>
              <li class="contact__info-item">
                <span class="contact__info-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                </span>
                <div>
                  <span class="contact__info-label">Office Hours</span>
                  <span class="contact__info-value">Mon – Fri: 08:00 – 21:30</span>
                </div>
              </li>
            </ul>
          </div>
        </div>

      </div>
    </div>
  </section>

</Layout>

<style>
  .contact__grid {
    display:               grid;
    grid-template-columns: 60fr 40fr;
    gap:                   var(--space-16);
    align-items:           start;
  }

  /* ── Form ── */
  .contact__form {
    display:        flex;
    flex-direction: column;
    gap:            var(--space-5);
  }

  .form__row {
    display:               grid;
    grid-template-columns: 1fr 1fr;
    gap:                   var(--space-5);
  }

  .form__group {
    display:        flex;
    flex-direction: column;
    gap:            var(--space-2);
  }

  .form__label {
    font-size:      var(--text-sm);
    font-weight:    var(--fw-medium);
    color:          var(--grey-700);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
  }

  .form__input {
    border:          1px solid var(--grey-200);
    padding:         0.75rem var(--space-4);
    font-size:       var(--text-sm);
    color:           var(--grey-800);
    background:      var(--white);
    outline:         none;
    transition:      border-color var(--transition-fast),
                     box-shadow var(--transition-fast);
    font-family:     var(--font-body);
    width:           100%;
    border-radius:   var(--radius-none);
    -webkit-appearance: none;
    appearance: none;
  }

  .form__input:focus {
    border-color: var(--grey-800);
    box-shadow:   0 0 0 3px rgba(26,26,26,0.08);
  }

  .form__input::placeholder {
    color: var(--grey-300);
  }

  .form__select {
    cursor: pointer;
  }

  .form__textarea {
    min-height:  160px;
    resize:      vertical;
    line-height: var(--lh-relaxed);
  }

  /* ── Info Card ── */
  .contact__info-card {
    background:  var(--grey-800);
    padding:     var(--space-8);
    color:       var(--grey-200);
  }

  .contact__info-card h4 {
    font-size:     var(--text-xl);
    font-weight:   var(--fw-bold);
    color:         var(--white);
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-4);
    border-bottom:  1px solid var(--grey-700);
  }

  .contact__info-list {
    list-style:     none;
    display:        flex;
    flex-direction: column;
    gap:            var(--space-6);
  }

  .contact__info-item {
    display:     flex;
    gap:         var(--space-4);
    align-items: flex-start;
  }

  .contact__info-icon {
    flex-shrink:     0;
    width:           40px;
    height:          40px;
    border:          1px solid var(--grey-700);
    display:         flex;
    align-items:     center;
    justify-content: center;
    color:           var(--grey-300);
    margin-top:      2px;
  }

  .contact__info-label {
    display:        block;
    font-size:      var(--text-xs);
    color:          var(--grey-400);
    text-transform: uppercase;
    letter-spacing: var(--ls-wide);
    margin-bottom:  4px;
  }

  .contact__info-value {
    display:     block;
    font-size:   var(--text-sm);
    font-weight: var(--fw-medium);
    color:       var(--white);
    text-decoration: none;
    transition:  opacity var(--transition-fast);
  }
  a.contact__info-value:hover {
    opacity: 0.75;
  }

  /* ── Success / Error states ── */
  .form__success {
    display:         flex;
    flex-direction:  column;
    align-items:     center;
    justify-content: center;
    text-align:      center;
    gap:             var(--space-4);
    padding:         var(--space-12) var(--space-8);
    background:      var(--grey-025);
    border:          1px solid var(--grey-100);
  }
  .form__success[hidden] { display: none; }

  .form__success svg {
    width:           56px;
    height:          56px;
    padding:         14px;
    border-radius:   50%;
    background:      var(--grey-800);
    color:           var(--white);
    flex-shrink:     0;
  }

  .form__success h3 {
    font-size:   var(--text-xl);
    font-weight: var(--fw-bold);
    color:       var(--grey-800);
    margin:      0;
  }

  .form__success p {
    font-size:  var(--text-sm);
    color:      var(--grey-500);
    margin:     0;
    max-width:  380px;
    line-height: var(--lh-relaxed);
  }

  .form__error {
    background:    #fff2f2;
    border:        1px solid #ffc0c0;
    color:         #8b0000;
    font-size:     var(--text-sm);
    padding:       var(--space-4) var(--space-5);
    margin-bottom: var(--space-4);
  }
  .form__error[hidden] { display: none; }

  #submitBtn:disabled {
    opacity: 0.6;
    cursor:  not-allowed;
  }

  @media (max-width: 1024px) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
    .form__row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form      = document.getElementById('contactForm') as HTMLFormElement;
  const submitBtn = document.getElementById('submitBtn')   as HTMLButtonElement;
  const errorBox  = document.getElementById('form-error')  as HTMLElement;
  const successBox = document.getElementById('form-success') as HTMLElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    errorBox.hidden = true;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending…';

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        body:   new FormData(form),
      });

      const data = await res.json();

      if (!res.ok) {
        errorBox.textContent = data.error ?? 'Something went wrong. Please try again.';
        errorBox.hidden = false;
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send Message';
        return;
      }

      form.style.display  = 'none';
      successBox.hidden   = false;
      successBox.style.display = 'flex';
    } catch {
      errorBox.textContent = 'Network error. Please check your connection and try again.';
      errorBox.hidden = false;
      submitBtn.disabled = false;
      submitBtn.textContent = 'Send Message';
    }
  });
</script>
