---
import Layout from '../../layouts/Layout.astro';
import PageBanner from '../../components/PageBanner.astro';
import { practiceAreas } from '../../data/practiceAreas.js';
---

<Layout title="Practice Areas" description="Explore Satya Shastra's full range of legal services across all major practice areas.">

  <PageBanner
    title="Practice Areas"
    breadcrumb={[{ label: 'Practice Areas' }]}
    bgImage="/images/judge-gavel-justice-lawyers-business-woman-in-suit-or-lawyer-working-on-a-documents-legal-law-e1666440633507-768x739.jpg"
  />

  <!-- ── Intro Section ── -->
  <section class="section section--sm">
    <div class="container">
      <div class="pa__intro-grid">
        <div>
          <span class="eyebrow">Our Services</span>
          <h2 class="section-title">Areas of Legal Practice</h2>
          <div class="divider"></div>
        </div>
        <div class="pa__intro-text">
          <p>We stand ready to deliver creative and tailor-made solutions and provide exceptionally high-quality advice in all major practice areas. Our attorneys bring decades of combined experience and a client-first approach to every matter we handle.</p>
          <p>Whether you are an individual, a family, or a corporation, Satya Shastra has the expertise to protect your rights and advance your interests across the full spectrum of legal challenges.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Cards + Sidebar ── -->
  <section class="section section--gray" style="padding-top: 0;">
    <div class="container">
      <div class="pa__layout">

        <!-- Practice Area Cards -->
        <div class="pa__cards-area">
          <div class="pa__cards-grid">
            {practiceAreas.map(area => (
              <article class="pa__card">
                <div class="pa__card-image-wrap">
                  <img src={area.image} alt={area.title} loading="lazy" />
                  <span class="pa__card-badge" set:html={area.icon} />
                </div>
                <div class="pa__card-body">
                  <h3 class="pa__card-title">{area.title}</h3>
                  <p class="pa__card-text">{area.excerpt}</p>
                  <a href={`/practice-areas/${area.slug}`} class="pa__card-link">
                    Service Details
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>

        <!-- Sidebar: Book Appointment Form -->
        <aside class="pa__sidebar">
          <div class="pa__form-box">
            <div class="pa__form-header">
              <h3>Book Appointment</h3>
              <p>Schedule a confidential consultation with our attorneys.</p>
            </div>
            <form class="pa__form" novalidate>
              <div class="pa__form-group">
                <label for="pa-name">Name</label>
                <input type="text" id="pa-name" name="name" placeholder="Your full name" required />
              </div>
              <div class="pa__form-group">
                <label for="pa-email">Email Address</label>
                <input type="email" id="pa-email" name="email" placeholder="Your email address" required />
              </div>
              <div class="pa__form-group">
                <label for="pa-phone">Phone Number</label>
                <input type="tel" id="pa-phone" name="phone" placeholder="Your phone number" />
              </div>
              <div class="pa__form-group">
                <label for="pa-details">Details</label>
                <textarea id="pa-details" name="details" rows="5" placeholder="Briefly describe your matter…"></textarea>
              </div>
              <button type="submit" class="btn btn--primary" style="width: 100%; justify-content: center;">
                Submit Request
              </button>
            </form>
          </div>

          <!-- Quick Contact -->
          <div class="pa__quick-contact">
            <h4>Need Immediate Help?</h4>
            <a href="tel:+11234567890" class="pa__quick-phone">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.19h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.77a16 16 0 0 0 6.29 6.29l.95-.95a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              +1 (123) 456 7890
            </a>
          </div>
        </aside>

      </div>
    </div>
  </section>

</Layout>

<style>
  /* ── Intro ── */
  .pa__intro-grid {
    display:               grid;
    grid-template-columns: 1fr 1fr;
    gap:                   var(--space-12);
    align-items:           start;
    padding-bottom:        var(--space-10);
  }

  .pa__intro-text p {
    font-size:     var(--text-sm);
    color:         var(--grey-500);
    line-height:   var(--lh-relaxed);
    margin-bottom: var(--space-4);
  }

  .section--sm { padding-bottom: var(--space-8); }

  /* ── Layout: Cards + Sidebar ── */
  .pa__layout {
    display:               grid;
    grid-template-columns: 1fr 340px;
    gap:                   var(--space-8);
    align-items:           start;
  }

  /* ── Cards Grid ── */
  .pa__cards-grid {
    display:               grid;
    grid-template-columns: repeat(2, 1fr);
    gap:                   var(--space-6);
  }

  .pa__card {
    background:  var(--white);
    border:      1px solid var(--grey-100);
    overflow:    visible;
    transition:  box-shadow var(--transition-normal), transform var(--transition-normal);
  }
  .pa__card:hover {
    box-shadow: 0 8px 32px rgba(0,0,0,0.1);
    transform:  translateY(-4px);
  }

  .pa__card-image-wrap {
    position:     relative;
    aspect-ratio: 4 / 3;
    overflow:     hidden;
    background:   var(--grey-100);
  }
  .pa__card-image-wrap img {
    width:      100%;
    height:     100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }
  .pa__card:hover .pa__card-image-wrap img {
    transform: scale(1.06);
  }

  .pa__card-badge {
    position:        absolute;
    bottom:          -18px;
    left:            50%;
    transform:       translateX(-50%);
    width:           40px;
    height:          40px;
    border-radius:   50%;
    background:      var(--grey-800);
    color:           var(--white);
    display:         flex;
    align-items:     center;
    justify-content: center;
    z-index:         2;
    border:          2px solid var(--grey-050);
  }

  .pa__card-body {
    padding: var(--space-8) var(--space-5) var(--space-6);
  }

  .pa__card-title {
    font-size:     var(--text-lg);
    font-weight:   var(--fw-bold);
    color:         var(--grey-800);
    margin-bottom: var(--space-3);
    line-height:   var(--lh-snug);
  }

  .pa__card-text {
    font-size:     var(--text-sm);
    color:         var(--grey-500);
    line-height:   var(--lh-relaxed);
    margin-bottom: var(--space-5);
  }

  .pa__card-link {
    display:         inline-flex;
    align-items:     center;
    gap:             var(--space-2);
    font-size:       var(--text-sm);
    font-weight:     var(--fw-semibold);
    color:           var(--grey-800);
    text-decoration: none;
    text-transform:  uppercase;
    letter-spacing:  var(--ls-wide);
    transition:      gap var(--transition-fast);
  }
  .pa__card-link:hover {
    gap: var(--space-3);
  }

  /* ── Sidebar Form ── */
  .pa__form-box {
    background: var(--grey-800);
    overflow:   hidden;
    margin-bottom: var(--space-4);
  }

  .pa__form-header {
    padding:       var(--space-6) var(--space-6) var(--space-4);
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }

  .pa__form-header h3 {
    font-size:     var(--text-xl);
    color:         var(--white);
    margin-bottom: var(--space-2);
    font-family:   var(--font-heading);
  }

  .pa__form-header p {
    font-size: var(--text-sm);
    color:     var(--grey-400);
  }

  .pa__form {
    padding: var(--space-5) var(--space-6) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .pa__form-group {
    display:        flex;
    flex-direction: column;
    gap:            var(--space-1);
  }

  .pa__form-group label {
    font-size:      var(--text-xs);
    font-weight:    var(--fw-semibold);
    color:          var(--grey-300);
    text-transform: uppercase;
    letter-spacing: var(--ls-wide);
  }

  .pa__form-group input,
  .pa__form-group textarea {
    background:    rgba(255,255,255,0.07);
    border:        1px solid rgba(255,255,255,0.12);
    color:         var(--white);
    font-size:     var(--text-sm);
    font-family:   var(--font-body);
    padding:       var(--space-3) var(--space-4);
    width:         100%;
    outline:       none;
    transition:    border-color var(--transition-fast), background var(--transition-fast);
    resize:        vertical;
  }

  .pa__form-group input::placeholder,
  .pa__form-group textarea::placeholder {
    color: var(--grey-500);
  }

  .pa__form-group input:focus,
  .pa__form-group textarea:focus {
    border-color: var(--grey-400);
    background:   rgba(255,255,255,0.1);
  }

  .pa__quick-contact {
    background:  var(--grey-050);
    border:      1px solid var(--grey-100);
    padding:     var(--space-5) var(--space-6);
  }

  .pa__quick-contact h4 {
    font-size:     var(--text-base);
    color:         var(--grey-800);
    margin-bottom: var(--space-3);
  }

  .pa__quick-phone {
    display:         flex;
    align-items:     center;
    gap:             var(--space-3);
    font-size:       var(--text-lg);
    font-weight:     var(--fw-bold);
    color:           var(--grey-800);
    text-decoration: none;
    transition:      color var(--transition-fast);
  }
  .pa__quick-phone:hover {
    color: var(--grey-600);
  }

  /* ── Responsive ── */
  @media (max-width: 1100px) {
    .pa__layout { grid-template-columns: 1fr; }
    .pa__sidebar {
      display:               grid;
      grid-template-columns: 1fr 1fr;
      gap:                   var(--space-4);
      align-items:           start;
    }
    .pa__form-box { margin-bottom: 0; }
  }

  @media (max-width: 1024px) {
    .pa__intro-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 768px) {
    .pa__sidebar { grid-template-columns: 1fr; }
  }

  @media (max-width: 600px) {
    .pa__cards-grid { grid-template-columns: 1fr; }
  }
</style>
